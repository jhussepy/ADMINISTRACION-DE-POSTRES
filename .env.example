# Supabase > Project Settings > API. Usa solo la clave pública/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Privada: configurar solo en Vercel/entorno seguro. Nunca exponer como NEXT_PUBLIC_*.
CLERK_SECRET_KEY=

# URL pública canónica del despliegue; sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Pagos V2 / Mercado Pago. Opcional hasta activar cobros online.
# Todas son privadas y se configuran solo en Vercel/servidor.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
